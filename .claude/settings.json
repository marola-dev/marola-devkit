{
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(git rev-parse --show-toplevel)/.claude/statusline.sh\""
  },
  "permissions": {
    "allow": [
      "Bash(gh auth status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh stack:*)",
      "Bash(just uprd:*)",
      "Bash(just uprds:*)",
      "Bash(just quality*)",
      "Bash(uprd:*)",
      "Bash(uprds:*)",
      "Bash(stack:*)",
      "Bash(cost-split:*)",
      "Bash(scripts/uprd.sh:*)",
      "Bash(scripts/uprds.sh:*)",
      "Bash(scripts/stack.sh:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(command -v *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh stack merge*)",
      "Bash(gh stack unstack*)",
      "Bash(gh stack delete*)"
    ]
  }
}
