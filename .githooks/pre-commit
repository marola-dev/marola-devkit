#!/usr/bin/env bash
# Runs the repo's own `just precommit`, the recipe a consuming repo implements (see README).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

git diff --cached --quiet && exit 0
if [[ -n "${IN_NIX_SHELL:-}" ]] || ! command -v nix >/dev/null 2>&1; then
  run=(just)
else
  run=(nix develop --command just)
fi
if [[ "${run[0]}" == just ]] && ! command -v just >/dev/null 2>&1; then
  echo "pre-commit: just is not installed; run inside 'nix develop' or install it (bypass: --no-verify)" >&2
  exit 1
fi
if ! "${run[@]}" --show precommit >/dev/null 2>&1; then
  echo "pre-commit: no 'precommit' recipe in this repo's justfile, skipping."
  exit 0
fi

if ! "${run[@]}" precommit; then
  echo "" >&2
  echo "pre-commit: just precommit failed — commit blocked." >&2
  echo "Fix it, or bypass with 'git commit --no-verify' if you really need to." >&2
  exit 1
fi
