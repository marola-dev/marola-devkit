#!/usr/bin/env bash
# Runs the repo's own `just prepush`, the recipe a consuming repo implements (see README). The
# site's MIP:-trailer rule stays in marola-site (MIP-0070 §5.6).
set -euo pipefail

remote="$1"
url="${2:-}"
cd "$(git rev-parse --show-toplevel)"

# git's own <local ref> <local sha1> <remote ref> <remote sha1> lines, one per pushed ref — stdin
# can only be read once, so this is saved to a file (MAROLA_PUSH_REFS_FILE below) rather than
# re-read, letting `just prepush` inspect the real push range instead of assuming HEAD's.
refs_file="$(mktemp)"
trap 'rm -f "$refs_file"' EXIT
cat > "$refs_file"

zero="0000000000000000000000000000000000000000"
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue      # deleting a remote branch: nothing to check
  pushing=1
done < "$refs_file"
[[ "$pushing" == 1 ]] || exit 0

if [[ -n "${IN_NIX_SHELL:-}" ]] || ! command -v nix >/dev/null 2>&1; then
  run=(just)
else
  run=(nix develop --command just)
fi
if [[ "${run[0]}" == just ]] && ! command -v just >/dev/null 2>&1; then
  echo "pre-push: just is not installed; run inside 'nix develop' or install it (bypass: --no-verify)" >&2
  exit 1
fi
if ! "${run[@]}" --show prepush >/dev/null 2>&1; then
  echo "pre-push: no 'prepush' recipe in this repo's justfile, skipping."
  exit 0
fi

if ! MAROLA_PUSH_REFS_FILE="$refs_file" "${run[@]}" prepush "$remote" "$url"; then
  echo "" >&2
  echo "pre-push: just prepush failed — push to '$remote' blocked." >&2
  echo "Fix it, or bypass with 'git push --no-verify' if you really need to." >&2
  exit 1
fi
