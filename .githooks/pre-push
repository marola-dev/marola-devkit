#!/usr/bin/env bash
# Runs the repo's own `just prepush`, the recipe a consuming repo implements (see README). The
# site's MIP:-trailer rule stays in marola-site (MIP-0070 §5.6).
set -euo pipefail

remote="$1"
url="${2:-}"
cd "$(git rev-parse --show-toplevel)"

# git's own <local ref> <local sha1> <remote ref> <remote sha1> lines, one per pushed ref, read
# once here and saved (MAROLA_PUSH_REFS_FILE) so `just prepush` can inspect the real push range
# instead of assuming HEAD's. A delete (<local sha1> all zeros) is marked "(delete)" rather than
# left for a recipe to notice the all-zero convention itself.
zero="0000000000000000000000000000000000000000"
refs_file="$(mktemp)"
trap 'rm -f "$refs_file"' EXIT
pushing=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" == "$zero" ]]; then
    printf '%s %s %s %s (delete)\n' "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" >> "$refs_file"
    continue      # deleting a remote branch: nothing to check
  fi
  printf '%s %s %s %s\n' "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" >> "$refs_file"
  pushing=1
done
[[ "$pushing" == 1 ]] || exit 0

if [[ -n "${IN_NIX_SHELL:-}" ]] || ! command -v nix >/dev/null 2>&1; then
  run=(just)
else
  run=(nix develop --command just)
fi
if [[ "${run[0]}" == just ]] && ! command -v just >/dev/null 2>&1; then
  echo "pre-push: just is not installed; run inside 'nix develop' or install it (bypass: --no-verify)" >&2
  exit 1
fi
if ! "${run[@]}" --show prepush >/dev/null 2>&1; then
  echo "pre-push: no 'prepush' recipe in this repo's justfile, skipping."
  exit 0
fi

# No positional args: a parameterless `prepush` recipe (today's norm) must keep working — `just
# prepush origin` would otherwise try to run a recipe named "origin" and block every push.
if ! MAROLA_PUSH_REMOTE="$remote" MAROLA_PUSH_URL="$url" MAROLA_PUSH_REFS_FILE="$refs_file" "${run[@]}" prepush; then
  echo "" >&2
  echo "pre-push: just prepush failed — push to '$remote' blocked." >&2
  echo "Fix it, or bypass with 'git push --no-verify' if you really need to." >&2
  exit 1
fi
